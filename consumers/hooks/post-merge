#!/usr/bin/env bash
#
# KIT-CLASS: KIT — advisory-nag hook template. See process/EXTRACTION.md.
#
# post-merge — the vendored-artifact update nag (ADVISORY ONLY; never updates).
#
# A consumer installs this to be TOLD when a newer upstream release exists. It
# only runs `scripts/update_vendored.sh --check`, which reports and never
# writes:
#   • it never updates the vendored artifact,
#   • it never touches ./vendor/,
#   • it never fails your merge or pull (it always exits 0).
# Updating stays a deliberate, human-run `scripts/update_vendored.sh [tag]`.
#
# Git runs this hook after `git pull` / `git merge`. The check touches the
# network (one lightweight `git ls-remote`) only then — never on other git
# operations.
#
# That is why the hook sets VENDORED_CHECK_NOTES=0 below: the what-changed report
# needs a shallow clone, too slow for every `git pull`. Run
# `scripts/update_vendored.sh --check` yourself for the detail.
#
# ── Install (from the consumer repo root) ────────────────────────────────────
# After `setup-consumer.sh` has run, the template sits in the consumer's own
# scripts/ as `<vendored-name>-post-merge.hook`, so no path editing is needed:
#
#     cp scripts/<vendored-name>-post-merge.hook .git/hooks/post-merge
#     chmod +x .git/hooks/post-merge
#
# The identical body also works as `.git/hooks/post-checkout` if you prefer to
# be nagged on branch switches too (noisier). One hook is plenty.
# ─────────────────────────────────────────────────────────────────────────────

# The consumer's own copy of the refresh script. Git runs hooks with the working
# directory at the repo root, so this consumer-relative path resolves correctly.
CHECK="scripts/update_vendored.sh"

# The label this nag prints, so a consumer vendoring more than one upstream can
# tell the messages apart. Set it to the same value as the update script's
# VENDORED_NAME seam.
LABEL="<vendored-name>"

# Nag-only + fail-safe: ANY problem (script missing, remote offline, no tags, an
# ambiguous vendor/ directory, …) must NOT break the consumer's git workflow. We
# swallow errors and always exit 0. `--check` itself never writes, so there is
# nothing to undo.
#
# The `case` reads only the FIRST stdout line: --check prints exactly one verdict
# line there (`UP TO DATE`, `UPDATE AVAILABLE` or `AHEAD`), narration on stderr.
if [ -x "$CHECK" ]; then
    if out="$(VENDORED_CHECK_NOTES=0 "$CHECK" --check 2>/dev/null | head -1)"; then
        case "$out" in
            "UPDATE AVAILABLE"*)
                printf '\n[%s] %s\n' "$LABEL" "$out"
                printf '[%s] Updating is DELIBERATE and manual — run:  %s\n\n' "$LABEL" "$CHECK"
                ;;
            "")
                : # nothing to say (check could not run) — stay silent
                ;;
            *)
                # UP TO DATE / AHEAD — one quiet line, no nagging.
                printf '[%s] %s\n' "$LABEL" "$out"
                ;;
        esac
    fi
fi

# Advisory only: the hook's own exit status is always success.
exit 0
