#!/usr/bin/env bash
# KIT-CLASS: KIT — the same commit-message guard on the applypatch path. See process/EXTRACTION.md.
# `git am` runs THIS hook, not commit-msg — and its mailinfo strips bracketed subject
# tags, so a `format-patch | am` relocation silently drops the `[Dev]` prefix. Delegate,
# so both paths judge a message the same way; the correct relocation is
# `git format-patch -k` + `git am -k` (`am -k` ALONE keeps the `[PATCH] ` prefix and is
# rejected here on purpose).
#
# Delegation carries BOTH of commit-msg's rules, which matters most for the second one:
# an imported patch is the likeliest carrier of a generated co-author trailer, because
# its message was composed somewhere else. When the import is a third party's commit and
# the message must travel verbatim, the escape is commit-msg's documented one —
# `MSG_OK=1 git am …` — not a hole in this entrance.
exec "$(dirname "$0")/commit-msg" "$@"
