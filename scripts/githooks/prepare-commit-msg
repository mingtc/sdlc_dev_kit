#!/usr/bin/env bash
# KIT-CLASS: KIT — the commit-message guard on the replay path. See process/EXTRACTION.md.
# `git cherry-pick` and a rebase's picks write a commit without running commit-msg, so a replayed
# commit with no role tag would reach the trunk unjudged. They do run THIS hook, with the message
# in hand and the source `message`. Delegate to commit-msg for them, so every path judges a message
# the same way, and tell it which operation is replaying (KIT_REPLAY) so its refusal prints that
# operation's own way out.
#
# It judges a commit only when it IS the replay's own: git holds CHERRY_PICK_HEAD while it makes the
# commit, and a stale one (an empty pick leaves it behind) must not turn the user's own commit into a
# replay, so the message being committed must carry the subject of the commit CHERRY_PICK_HEAD names.
# A rebase is told from a cherry-pick run at its edit stop by the rebase's own last todo line.
#
# What it does not judge, and commit-msg or the drift report does: an ordinary `git commit`; a message
# git hands the editor first (`cherry-pick -e`, a rebase reword: source `commit` or `merge`); a rebase
# pick finished with `rebase --continue` after a conflict, where git keeps REBASE_HEAD and no
# CHERRY_PICK_HEAD; and a `fixup -C` in `rebase -i`, which has no CHERRY_PICK_HEAD either.
# `rebase --apply` runs applypatch-msg, which delegates to commit-msg, not this hook.
#
# Bypass: MSG_OK=1, the same escape commit-msg documents (`MSG_OK=1 git cherry-pick <sha>`). `--no-verify`
# does not reach this hook: git skips only pre-commit and commit-msg under it, and `cherry-pick` has no
# such flag.
set -uo pipefail

MSG_FILE="${1:-}"; SOURCE="${2:-}"
[ -n "$MSG_FILE" ] && [ "$SOURCE" = "message" ] || exit 0

GIT_DIR_NOW="$(git rev-parse --git-dir 2>/dev/null || true)"
[ -n "$GIT_DIR_NOW" ] && [ -f "$GIT_DIR_NOW/CHERRY_PICK_HEAD" ] || exit 0

# Is the message being committed the replayed commit's own? Both sides are raw messages put through the
# same extraction: the first line that is not blank, with a carriage return and trailing blanks stripped
# (a `%s` subject would join a wrapped first paragraph and differ from the file's first line).
_first_line() { sed -e 's/\r$//' -e 's/[[:space:]]*$//' | sed -e '/^$/d' | head -1; }
replayed="$(git cat-file commit CHERRY_PICK_HEAD 2>/dev/null | sed '1,/^$/d' | _first_line || true)"
subj="$(_first_line < "$MSG_FILE" 2>/dev/null || true)"
[ "$subj" = "$replayed" ] || exit 0

KIT_REPLAY=cherry-pick
if [ -d "$GIT_DIR_NOW/rebase-merge" ]; then
  # The rebase's own pick is the last line of its `done` list; a cherry-pick run at an edit stop names another commit.
  done_sha="$(tail -n 1 "$GIT_DIR_NOW/rebase-merge/done" 2>/dev/null | awk '{print $2}' || true)"
  cph="$(git rev-parse CHERRY_PICK_HEAD 2>/dev/null || true)"
  if [ -n "$done_sha" ] && [ -n "$cph" ]; then
    case "$cph" in "$done_sha"*) KIT_REPLAY=rebase ;; esac
  fi
fi
export KIT_REPLAY
# More picks queued after this one: the commands then end in `git cherry-pick --continue`, which fails once none is left.
if [ "$KIT_REPLAY" = cherry-pick ] && [ -f "$GIT_DIR_NOW/sequencer/todo" ] \
   && [ "$(grep -c '^[a-z]' "$GIT_DIR_NOW/sequencer/todo" 2>/dev/null || true)" -gt 1 ]; then
  export KIT_REPLAY_RANGE=1
fi

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P || true)"
[ -e "$HOOK_DIR/commit-msg" ] || exit 0
exec "$HOOK_DIR/commit-msg" "$MSG_FILE"
