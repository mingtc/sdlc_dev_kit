#!/usr/bin/env bash
# KIT-CLASS: KIT — reads the project's CODE_GLOBS declaration from scripts/config.sh (itself the
# configuration seam), and carries no project-owned part of its own. See process/EXTRACTION.md.
# The code-vs-metadata rule made mechanical at the write-time entrance
# (process/MANUAL.md § The code-vs-metadata rule): a commit whose staged paths are ALL
# metadata (none matches CODE_GLOBS) is refused on any branch OTHER THAN the trunk, naming
# scripts/register-commit.sh as the route.
#
# It also refuses ANY commit while no hat is declared (process/contracts/role-gate.md § 2), whatever
# the paths; the HAT GATE block below says what counts as declared and what is exempt. It refuses
# a commit that stages the hat file itself (a staged deletion passes), in every checkout.
#
# CODE_GLOBS UNDECLARED (the shipped, empty state) MEANS UNENFORCED, NOT "NO CODE EXISTS": this
# hook is a no-op until the adapter fills it in, the same convention verify.sh's GUARD_ENUM=""
# and GATES=() already use. Reading empty as "everything is metadata" would refuse ordinary
# feature-branch commits on every project that has not yet filled the seam in.
#
# WHY: "direct to the trunk" names the trunk REF, not a checkout — a commit made ON THE TRUNK
# BRANCH from a linked worktree lands there just the same, so this hook does not care which
# checkout you are in. What it catches is a metadata edit committed onto a BRANCH OF ITS OWN —
# the shape a harness's own linked-worktree tool hands you by default when it puts you on a
# fresh branch instead of the trunk ref. A DETACHED HEAD (the kanban worktree's own state, and
# any checkout deliberately given up per that section) is not "a branch of its own" and is never
# refused here.
#
# Wired via `git config core.hooksPath scripts/githooks`, the same as commit-msg: kit-init.sh
# wires it at adoption and setup.sh re-wires it on every fresh clone. It fires in every
# worktree sharing that config, .kanban-wt/ included — where HEAD is always detached, so it is
# never the one refused.
#
# Bypass:  MSG_OK=1 git commit …   (the SAME escape commit-msg documents; one bypass knob, not
#          two names for a caller to remember). Not for your own commits.
set -uo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P || true)"
if [ -n "$HOOK_DIR" ] && [ -r "$HOOK_DIR/../lib/refuse.sh" ]; then
  # shellcheck source=../lib/refuse.sh
  . "$HOOK_DIR/../lib/refuse.sh" 2>/dev/null || true
fi

# The documented escape — same variable, same truthy values, as commit-msg.
case "${MSG_OK:-}" in
  1|true|yes) exit 0 ;;
esac

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$ROOT" ] || exit 0   # not inside a work tree at all (defensive; git would already refuse)

# ── THE HAT GATE: a commit needs a declared hat (process/contracts/role-gate.md § 2). The editor-tool
# gate does not see a mutation made through a shell, and every such mutation must pass a commit to
# count, so the commit refuses when no hat is declared. Declared means one of:
#   • the hat file exists in this checkout or in the repository's main checkout (existence only —
#     the same test the editor-tool gate makes; the operator waiver is a line in it);
#   • the committing script set the variable lib/hat-file.sh names, for this one commit.
# Exempt by one rule: a commit in the standing kanban worktree (`.kanban-wt`, detached, linked). It
# is no session's checkout and holds no hat file; every board script that commits there names a role,
# checked against the declared role set, in the subject the commit-msg hook holds.
# Not seen: a change left uncommitted, and a commit made under MSG_OK (the escape above).
KIT_HAT_FILE_REL=""; KIT_HAT_ENV=""
# shellcheck source=../lib/hat-file.sh
if [ -n "$HOOK_DIR" ] && [ -r "$HOOK_DIR/../lib/hat-file.sh" ]; then
  . "$HOOK_DIR/../lib/hat-file.sh" 2>/dev/null || true
fi
_hat_exempt=0
case "$ROOT" in
  */.kanban-wt)
    if ! git symbolic-ref -q HEAD >/dev/null 2>&1 \
       && [ "$(git rev-parse --git-dir 2>/dev/null)" != "$(git rev-parse --git-common-dir 2>/dev/null)" ]; then
      _hat_exempt=1
    fi ;;
esac
if [ "$_hat_exempt" -eq 0 ]; then
  hm1=""; hm2=""; hm4=""; hm5=""
  if [ -z "$KIT_HAT_FILE_REL" ] || [ -z "$KIT_HAT_ENV" ]; then
    # Without the lib the hat file's path is unknown, and a gate that allows on doubt reads as armed.
    hm1="✗ pre-commit guard: scripts/lib/hat-file.sh is unreadable, so the hat file's path is unknown — refusing the commit."
    hm4="Next: restore it with  git checkout -- scripts/lib/hat-file.sh  (or from the release zip), then commit again."
  else
    _hat_main=""
    _hat_common="$(git rev-parse --git-common-dir 2>/dev/null || true)"
    if [ -n "$_hat_common" ] && [ "$(basename "$_hat_common")" = ".git" ]; then
      _hat_main="$(cd "$_hat_common/.." 2>/dev/null && pwd -P || true)"
    fi
    if [ ! -e "$ROOT/$KIT_HAT_FILE_REL" ] \
       && { [ -z "$_hat_main" ] || [ ! -e "$_hat_main/$KIT_HAT_FILE_REL" ]; } \
       && [ -z "${!KIT_HAT_ENV:-}" ]; then
      hm1="✗ pre-commit guard: no hat is declared ($KIT_HAT_FILE_REL does not exist) — refusing a commit that changes the repository with no role behind it."
      hm2="  process/contracts/role-gate.md § 2: changing the repository needs a hat, through any tool; a shell command or a script is not exempt."
      hm4="Next: declare your hat, then commit again. Write $KIT_HAT_FILE_REL (create .kit/ if absent) with a single line:  <Role> <scope>"
      hm5="      e.g.  Dev <PREFIX>-001
    or — ONLY when the operator explicitly waived the hat —  none — operator override: <reason>
  A hat file is session state and is never committed. Read-only work needs no hat."
    fi
  fi
  if [ -n "$hm1" ]; then
    if command -v kit_refuse >/dev/null 2>&1; then
      kit_refuse 1 pre-commit-hat-missing "$hm1" "$hm2" "" "$hm4" "$hm5"
    fi
    printf '%s\n' "$hm1" "$hm2" "" "$hm4" "$hm5" >&2
    exit 1   # exit-class: fallback
  fi
fi

# THE HAT FILE IS NEVER COMMITTED: it is session state, and a tracked one forks per branch and
# blocks a `git switch`. Refused in every checkout, the kanban worktree included, so every route
# is covered. A staged DELETION passes: it is the fix the Next: line names.
if [ -n "$KIT_HAT_FILE_REL" ] \
   && [ -n "$(git -C "$ROOT" diff --cached --name-only --diff-filter=d -- "$KIT_HAT_FILE_REL" 2>/dev/null || true)" ]; then
  hf1="✗ pre-commit guard: $KIT_HAT_FILE_REL is staged — a hat file is session state and is never committed."
  hf2="Next: unstage it and keep it out of the tree:  git rm --cached $KIT_HAT_FILE_REL  and ignore it (add $KIT_HAT_FILE_REL to .gitignore), then commit again."
  hf3="  Stage paths by name rather than with  git add -A  when a staging commit may sweep it in."
  if command -v kit_refuse >/dev/null 2>&1; then
    kit_refuse 1 pre-commit-hat-file-staged "$hf1" "$hf2" "$hf3"
  fi
  printf '%s\n' "$hf1" "$hf2" "$hf3" >&2
  exit 1   # exit-class: fallback
fi

# DETACHED HEAD → never refused (see WHY above): the kanban worktree's permanent state, and any
# checkout deliberately given up per process/MANUAL.md § The code-vs-metadata rule.
BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
[ -n "$BRANCH" ] || exit 0

# THE TRUNK, resolved the SAME CHAIN kwt_resolve uses (config-seam.md § 2), inlined rather than
# sourcing the full kanban-worktree.sh library: this hook fires on every commit and must not pay
# for (or depend on) the push-retry load that library's sourcing requires. Each step below is
# read-only and never refuses; an unresolved trunk falls through to the last resort, same as
# there.
KWT_REMOTE="${KWT_REMOTE:-origin}"
TRUNK="$(git -C "$ROOT" symbolic-ref --short "refs/remotes/$KWT_REMOTE/HEAD" 2>/dev/null | sed "s|^$KWT_REMOTE/||" || true)"
[ -n "$TRUNK" ] || TRUNK="$(git -C "$ROOT" config --get init.defaultBranch 2>/dev/null || true)"
[ -n "$TRUNK" ] || TRUNK="${KWT_TRUNK_LAST_RESORT:-main}"

# On the trunk branch itself → never refused (this hook's whole point is the OFF-trunk case).
[ "$BRANCH" != "$TRUNK" ] || exit 0

# CODE_GLOBS: the one project-supplied definition (process/MANUAL.md § The code-vs-metadata
# rule). Read from config.sh WITHOUT sourcing it (config.sh may itself be one of the staged
# paths mid-edit, and sourcing arbitrary staged content into a hook is not a thing to do) — by
# lib/glob-array.sh's kit_glob_array, the one reader of that array. Without the library the
# declaration cannot be read, and a gate that allows on doubt reads as armed, so the commit is refused.
CODE_GLOBS=()
CFG="$ROOT/scripts/config.sh"
if [ -r "$CFG" ]; then
  KIT_GLOB_LIB_OK=0
  # shellcheck source=../lib/glob-array.sh
  if [ -n "$HOOK_DIR" ] && [ -r "$HOOK_DIR/../lib/glob-array.sh" ] \
     && . "$HOOK_DIR/../lib/glob-array.sh" 2>/dev/null && command -v kit_glob_array >/dev/null 2>&1; then
    KIT_GLOB_LIB_OK=1
  fi
  if [ "$KIT_GLOB_LIB_OK" -eq 0 ]; then
    gm1="✗ pre-commit guard: scripts/lib/glob-array.sh is unreadable, so CODE_GLOBS cannot be read — refusing the commit."
    gm2="Next: restore it with  git checkout -- scripts/lib/glob-array.sh  (or from the release zip), then commit again."
    if command -v kit_refuse >/dev/null 2>&1; then
      kit_refuse 1 pre-commit-glob-lib-missing "$gm1" "$gm2"
    fi
    printf '%s\n' "$gm1" "$gm2" >&2
    exit 1   # exit-class: fallback
  fi
  while IFS= read -r _line; do
    case "$_line" in E\|*) CODE_GLOBS+=("${_line#E|}") ;; esac
  done < <(kit_glob_array CODE_GLOBS "$CFG")
fi

# UNDECLARED CODE_GLOBS IS NOT "NO CODE EXISTS" — it is "this project has not said yet," and
# this hook must not read it as the latter: an empty array would then make every ordinary
# feature-branch commit read as metadata-only and refuse it, on every project that has not
# filled the seam in. Same convention verify.sh's GUARD_ENUM="" and GATES=() already use
# (config-seam.md): empty means unenforced here, not "everything matches the empty rule."
if [ ${#CODE_GLOBS[@]} -eq 0 ]; then
  exit 0
fi

STAGED="$(git -C "$ROOT" diff --cached --name-only 2>/dev/null || true)"
[ -n "$STAGED" ] || exit 0   # nothing staged (e.g. an empty/allow-empty commit) — nothing to judge

ANY_CODE=0
while IFS= read -r _path; do
  [ -n "$_path" ] || continue
  for _g in "${CODE_GLOBS[@]}"; do
    case "$_path" in
      $_g) ANY_CODE=1 ;;
    esac
  done
done <<PC_STAGED
$STAGED
PC_STAGED

# Every staged path is metadata (CODE_GLOBS is declared and non-empty, and no entry matched)
# AND we are on a branch that is not the trunk → refuse, naming the route.
if [ "$ANY_CODE" -eq 0 ]; then
  msg1="✗ pre-commit guard: this commit touches only metadata paths, and HEAD is on '$BRANCH' — a branch of its own, not the trunk ('$TRUNK')."
  msg2="  process/MANUAL.md § The code-vs-metadata rule: metadata commits direct to the TRUNK REF."
  msg3="  \"Direct to the trunk\" names the ref, not a checkout — a linked worktree on a branch of"
  msg4="  its own (the shape a harness's own worktree tool hands you by default) is not the trunk"
  msg5="  ref, so a hand-made commit here is off the rule's one route."
  msg6="Next: route it to the trunk instead:"
  msg7="    ./scripts/register-commit.sh --role <R> --message \"...\" <path>..."
  msg8="  It never commits in this checkout — it lands the same content on the trunk through the"
  msg9="  standing kanban worktree, the way move-issue.sh lands a board move."
  msg10="  Staged paths:"
  msg11="$(printf '%s\n' "$STAGED" | sed 's/^/    /')"
  msg12="  Genuinely need to commit here anyway (importing a third party's commit verbatim, or a"
  msg13="  one-off this project has already judged)?  MSG_OK=1 git commit …"
  if command -v kit_refuse >/dev/null 2>&1; then
    kit_refuse 1 pre-commit-metadata-off-trunk "$msg1" "$msg2" "$msg3" "$msg4" "$msg5" "" "$msg6" "$msg7" "" "$msg8" "$msg9" "" "$msg10" "$msg11" "" "$msg12" "$msg13"
  fi
  printf '%s\n' "$msg1" "$msg2" "$msg3" "$msg4" "$msg5" "" "$msg6" "$msg7" "" "$msg8" "$msg9" "" "$msg10" "$msg11" "" "$msg12" "$msg13" >&2
  exit 1   # exit-class: fallback
fi

exit 0
