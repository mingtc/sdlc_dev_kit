#!/usr/bin/env bash
# KIT-CLASS: MIXED — kit mechanism, PROJECT prefix set (ROLE_PREFIXES below) — configure on adoption. See process/EXTRACTION.md.
# Commit-message guard — two rules, one hook:
#   (1) the SUBJECT declares the acting role — process/contracts/commit-attribution.md
#   (2) the MESSAGE carries no generated co-author trailer and no "Generated with …"
#       line — process/doctrine/commit-hygiene.md § A.1
#
# (1) THE ROLE PREFIX.
# The adapter's § "Branching and role attribution": every commit begins with a role
# tag ([PM] / [Dev] / [QA] / …). Role attribution for the one-operator-many-hats model
# comes from these prefixes cross-checked against the issue-file Activity logs — so a
# prefix-less commit erodes the audit trail. This hook rejects any commit whose SUBJECT
# line does not start with a known role tag.
#
# Wired via `git config core.hooksPath scripts/githooks` (set by scripts/kit-init.sh);
# hooksPath lives in the shared .git/config, so the guard is active from every worktree —
# including the standing .kanban-wt/ where move-issue.sh commits its "[Role] <ID> → …"
# messages (those pass by construction). finish-pr.sh is pure git (no forge CLI): its
# squash-merge commits LOCALLY inside .kanban-wt/, so this hook DOES fire on them — and
# passes, because the squash subject carries the leading "[QA]" prefix and its message is
# one line, so it satisfies rule (2) by construction too.
#
# (2) NO GENERATED CO-AUTHOR TRAILER.
# doctrine/commit-hygiene.md § A.1 states it as an absolute on purpose and says why:
# "usually not" is a rule every hurried session resolves in favour of the default the
# tool ships with, and the default is to add the trailer. An absolute is a rule a hook
# can enforce — so this one does. It reads the WHOLE message, not only the subject,
# because the trailer lives in the body; that is also why the auto-exempt subjects below
# are exempt from rule (1) ONLY. A merge or a revert carries a body like anything else.
#
# TOOL-naming trailers only, and that is a decision rather than an oversight. § A.1's
# text is "naming a tool", and a `Co-Authored-By:` naming a HUMAN is legitimate practice
# — a real pairing session, a patch author credited on import — so it is accepted. The
# markers live in TOOL_TRAILER_MARKERS below: one named line, extended in one place by a
# project that meets a new tool, matched at a word boundary (so a human "Claudette" is
# not a "Claude"), and free of regex metacharacters so the refusal can print the very
# list it enforces. Unlike ROLE_PREFIXES it is a kit default rather than project law:
# nothing stamps it on adoption.
#
# Bypass:  MSG_OK=1 git commit …   (1 / true / yes are truthy; 0 or unset do NOT bypass).
#          For a genuine one-off that legitimately can't carry a tag — and, for rule (2),
#          for importing a third party's commit VERBATIM (a cherry-pick, or a `git am` of
#          a patch whose message already carries a tool trailer), where rewriting someone
#          else's message is the worse of the two evils. Not for your own commits.
#
# Auto-exempt from rule (1): git/host-generated subjects that are never authored by a
# role — merge commits, revert commits, and rebase autosquash markers.
set -uo pipefail

# $1 is the path to the file holding the proposed commit message.
MSG_FILE="${1:-}"
[ -z "$MSG_FILE" ] && exit 0            # no message file → nothing to guard (defensive)

# THE ACCEPTED ROLE TAGS — the kit's default set, matching the role docs under
# .claude/roles/. Kept as a named var on its OWN LINE so every other consumer can
# DERIVE the list with one sed rather than re-hardcoding it (hard-won: the day a
# re-hardcoded copy drifted, the standing seat could not move a card because this
# hook accepted a role that move-issue.sh's whitelist did not).
# ERE alternation. THE ROLE SET IS CARRIED IN SEVERAL FILES — change one, change
# them all. The authoritative list is the TABLE in process/EXTRACTION.md § 2.4;
# read it there rather than trusting a count written here. (This line used to say
# FOUR files and to cite a section title that never existed.)
ROLE_PREFIXES='PM|Dev|QA|Refactorer|UIDesigner|Orchestrator|Architect'

# THE TOOL MARKERS for rule (2) — likewise a named var on its own line, so the
# refusal text and any test DERIVE the list instead of restating it. Plain words
# only, no regex metacharacters: the matcher adds the word boundaries.
TOOL_TRAILER_MARKERS='claude|anthropic|copilot|chatgpt|openai|gpt|gemini|codex|aider|bot'

# Bypass — only the documented truthy values (`0` or unset reads as "off" and must NOT bypass).
case "${MSG_OK:-}" in
  1|true|yes) exit 0 ;;
esac

# THE MESSAGE AS GIT WILL KEEP IT, computed once and used by both rules:
#   • everything from `git commit -v`'s scissors line down is CUT. Below that line
#     sits a raw diff — uncommented, and carrying its context lines with one leading
#     space. Measured, not feared: with -v the hook receives the diff, so a scan of
#     the whole file would refuse any commit that merely EDITS a file containing a
#     trailer — this hook, or the doctrine sheet that states the rule. The marker is
#     matched by its dashes so it is found whatever `core.commentChar` is set to.
#   • comment lines are dropped. Git drops them later, but read the real message now
#     so a leading `# …` template line can't be read as a subject or as a trailer.
cleaned="$(sed -E '/-{5,}[[:space:]]*>8[[:space:]]*-{5,}/,$d' "$MSG_FILE" 2>/dev/null \
             | grep -vE '^[[:space:]]*#' || true)"

# --- RULE (2): no generated co-author trailer, no "Generated with …" line ----------
# Both arms anchor at the start of a line, because § A.1 forbids such a LINE — "the
# file was generated with the codegen step" mid-sentence is prose, not a provenance
# claim. The "Generated with" arm allows leading decoration, since the shape the
# tooling emits leads with an emoji rather than with the word.
offender="$(printf '%s\n' "$cleaned" \
  | grep -iE "^[[:space:]]*co-authored-by:.*[^[:alnum:]](${TOOL_TRAILER_MARKERS})([^[:alnum:]]|\$)" \
  | head -1 || true)"
[ -n "$offender" ] || offender="$(printf '%s\n' "$cleaned" \
  | grep -iE '^[^[:alnum:]]*generated with[[:space:]]' | head -1 || true)"

if [ -n "$offender" ]; then
  {
    echo "✗ Commit-message guard: no generated co-author trailer, and no \"Generated with …\" line."
    echo ""
    echo "  Offending line: $offender"
    echo ""
    echo "  process/doctrine/commit-hygiene.md § A.1 — attribution here is by ROLE (the subject"
    echo "  prefix, rule 1 of this hook). A tool trailer adds a second, unqueryable axis, makes a"
    echo "  provenance claim that ages badly, and taxes every git log a human reads, forever."
    echo ""
    echo "  Fix: delete the line and commit again."
    echo "  A Co-Authored-By naming a HUMAN is fine; the tool markers rejected are:"
    echo "    $(printf '%s' "$TOOL_TRAILER_MARKERS" | tr '|' ' ')"
    echo ""
    echo "  Importing a third party's commit verbatim?  MSG_OK=1 git commit …"
  } >&2
  exit 1
fi

# --- RULE (1): the subject declares the acting role -------------------------------
# First non-comment, non-blank line = the subject.
subject="$(printf '%s\n' "$cleaned" | grep -vE '^[[:space:]]*$' | head -1 || true)"

# Empty subject → let git handle it (it aborts the commit on its own). Not our job.
[ -z "$subject" ] && exit 0

# Auto-exempt host/git-generated subjects (never authored under a role).
case "$subject" in
  "Merge branch "*|"Merge remote-tracking branch "*|"Merge pull request "*|"Merge tag "*|"Merge commit "*) exit 0 ;;
  "Revert \""*|"Revert '"*) exit 0 ;;
  "Squash"*) exit 0 ;;            # a leading "Squash" subject (local squash-merge tooling)
  "fixup! "*|"squash! "*|"amend! "*) exit 0 ;;   # rebase autosquash markers
esac

# Accept when the subject starts with a known role tag: [Role] …
if printf '%s' "$subject" | grep -qE "^\[($ROLE_PREFIXES)\] "; then
  exit 0
fi

# The rejection message lists the accepted tags DERIVED from ROLE_PREFIXES above,
# so a set change cannot leave the help text lying about what is legal.
{
  echo "✗ Commit-message guard: subject must start with a role tag."
  echo ""
  echo "  Subject: $subject"
  echo ""
  echo "  Expected one of:  $(printf '%s' "$ROLE_PREFIXES" | tr '|' '\n' | sed 's/^/[/; s/$/]/' | tr '\n' ' ')"
  echo "  (the adapter's § 'Branching and role attribution' — the prefix is the audit trail)."
  echo ""
  echo "  Examples:"
  echo "    [Dev] <PREFIX>-001: add the download --help usage example"
  echo "    [QA] <PREFIX>-001 → qa_complete: PASS. Squash-merged into the trunk."
  echo ""
  echo "  Genuine one-off that can't carry a tag?  MSG_OK=1 git commit …"
} >&2
exit 1
