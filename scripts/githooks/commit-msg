#!/usr/bin/env bash
# KIT-CLASS: MIXED — kit mechanism, PROJECT prefix set (ROLE_PREFIXES below) — configure on adoption. See process/EXTRACTION.md.
# Commit-message guard — two rules, one hook:
#   (1) the SUBJECT declares the acting role — process/contracts/commit-attribution.md
#   (2) the MESSAGE carries no generated-attribution line, in any of its common wordings —
#       process/doctrine/commit-hygiene.md § A.1
#
# Wired via `git config core.hooksPath scripts/githooks`: `kit-init.sh` wires it at adoption and
# `setup.sh` re-wires it on every fresh clone (contracts/initializer.md § 2). hooksPath lives in
# the shared .git/config, so it fires in every worktree, .kanban-wt/ included; the kit's own
# board and squash commits pass by construction.
#
# Rule (2) reads the WHOLE message (the trailer lives in the body), so the auto-exempt subjects
# below are exempt from rule (1) ONLY. It refuses TOOL-naming attribution only: a Co-Authored-By
# naming a HUMAN is legitimate. TOOL_TRAILER_MARKERS is a kit default, not project law; nothing
# stamps it. It matches WORDINGS and a list of vendor and model-family words, not every tool's own
# name: a harness whose default trailer or banner uses none of those words is not caught. Add
# its word to TOOL_TRAILER_MARKERS (or its wording to ATTRIB_TRAILER_WORDS) below — this file is
# the one place either is authored.
#
# Bypass:  MSG_OK=1 git commit …   (1 / true / yes are truthy; 0 or unset do NOT bypass).
#          For a genuine one-off that can't carry a tag, or for importing a third party's
#          commit VERBATIM (a cherry-pick, a `git am`). Not for your own commits.
#
# Auto-exempt from rule (1): git/host-generated subjects that are never authored by a
# role — merge commits, revert commits, and rebase autosquash markers.
set -uo pipefail

# kit_refuse, if this hook can find it from where it runs (a sibling of scripts/githooks/).
# Sourced, never required: a hook that cannot find its own lib still refuses, it just does not
# leave a progress record behind. Never let a missing library turn a refusal into an accept.
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P || true)"
if [ -n "$HOOK_DIR" ] && [ -r "$HOOK_DIR/../lib/refuse.sh" ]; then
  # shellcheck source=../lib/refuse.sh
  . "$HOOK_DIR/../lib/refuse.sh" 2>/dev/null || true
fi

# lib/attrib-trailer.sh holds rule (2)'s one reader (kit_attrib_offender), the reader check-board.sh
# arm [h] calls on history. Rule (2) below refuses when it cannot be loaded; only kit_refuse is optional.
if [ -n "$HOOK_DIR" ] && [ -r "$HOOK_DIR/../lib/attrib-trailer.sh" ]; then
  # shellcheck source=../lib/attrib-trailer.sh
  . "$HOOK_DIR/../lib/attrib-trailer.sh" 2>/dev/null || true
fi

# $1 is the path to the file holding the proposed commit message.
MSG_FILE="${1:-}"
[ -z "$MSG_FILE" ] && exit 0            # no message file → nothing to guard (defensive)

# THE ACCEPTED ROLE TAGS, an ERE alternation on its OWN LINE so every consumer derives it with
# one sed instead of holding a copy. The set is carried in several files, listed in the table
# at process/EXTRACTION.md § 2.4: change one, change them all.
ROLE_PREFIXES='PM|Dev|QA|Refactorer|UIDesigner|Orchestrator|Architect'

# THE TOOL MARKERS for rule (2) — likewise a named var on its own line, so the
# refusal text and any test DERIVE the list instead of restating it. Plain words
# only, no regex metacharacters: the matcher adds the word boundaries.
TOOL_TRAILER_MARKERS='claude|anthropic|copilot|chatgpt|openai|gpt|gemini|codex|aider|bot|opus|sonnet|haiku|fable|llama|mistral|grok|deepseek|qwen'

# THE ATTRIBUTION-TRAILER WORDINGS for rule (2)'s trailer form — one alternation, so a new
# wording is added here once rather than re-taught to a single hardcoded "co-authored-by:".
# `generated-by:` lands here too (a colon trailer); "generated with …" and "written with/by …"
# are PROSE, not trailers, and are their own arms in the reader because they carry no `-by:` shape.
# lib/attrib-trailer.sh reads this line and the one above by their text: keep each on a line of its own.
ATTRIB_TRAILER_WORDS='co-authored-by|co-developed-by|assisted-by|generated-by|signed-off-by'

# Bypass — only the documented truthy values (`0` or unset reads as "off" and must NOT bypass).
case "${MSG_OK:-}" in
  1|true|yes) exit 0 ;;
esac

# THE MESSAGE AS GIT WILL KEEP IT, used by both rules:
#   • everything from `git commit -v`'s scissors line down is CUT: below it sits a raw diff, so
#     a commit that merely edits a file containing a trailer would be refused. Matched by its
#     dashes, whatever `core.commentChar` is.
#   • comment lines are dropped, so a `# …` template line is never read as subject or trailer.
cleaned="$(sed -E '/-{5,}[[:space:]]*>8[[:space:]]*-{5,}/,$d' "$MSG_FILE" 2>/dev/null \
             | grep -vE '^[[:space:]]*#' || true)"

# --- RULE (2): no generated-attribution line, in any of its common wordings --------
# ONE READER, kit_attrib_offender (lib/attrib-trailer.sh), reading the declarations above from this
# file: three arms, all anchored at a line start, because § A.1 forbids such a LINE and mid-sentence
# prose is not one.
#   (a) a `<word>-by:` TRAILER naming a tool, optionally behind a list bullet or a backtick, blanks
#       before the colon tolerated; a human whose name merely begins with a marker (`Claudia`) is
#       accepted, and `Reviewed-by:` is not in the word list — reviewing is not authorship.
#   (b) "generated with/by …" PROSE — no marker required, because the phrase itself is the claim.
#   (c) "written with/by …" PROSE — a marker IS required: "written with care" is ordinary prose.
# Unicode hyphens are folded first. A reader that did not load, or that does not read this file's
# own wording list, is a refusal, never an accept.
ATTRIB_ROOT="$HOOK_DIR/../.."
offender=""
if [ -n "$HOOK_DIR" ] && command -v kit_attrib_offender >/dev/null 2>&1 \
   && [ "$(kit_attrib_trailer_words "$ATTRIB_ROOT")" = "$ATTRIB_TRAILER_WORDS" ]; then
  offender="$(printf '%s\n' "$cleaned" | kit_attrib_offender "$ATTRIB_ROOT" || true)"
else
  rm1="✗ Commit-message guard: rule (2) cannot run — scripts/lib/attrib-trailer.sh did not load, or does not read this hook's ATTRIB_TRAILER_WORDS."
  rm2="Next: restore scripts/lib/attrib-trailer.sh from version control or the release zip, then commit again."
  rm3="  Importing a third party's commit verbatim?  MSG_OK=1 git commit …"
  if command -v kit_refuse >/dev/null 2>&1; then
    kit_refuse 1 commit-msg-attribution-reader-missing "$rm1" "" "$rm2" "" "$rm3"
  fi
  printf '%s\n' "$rm1" "" "$rm2" "" "$rm3" >&2
  exit 1   # exit-class: fallback
fi

if [ -n "$offender" ]; then
  msg1="✗ Commit-message guard: no generated-attribution line (a tool trailer, a \"Generated with/by …\" or \"Written with/by …\" line)."
  msg2="  Offending line: $offender"
  msg3="  process/doctrine/commit-hygiene.md § A.1 — attribution here is by ROLE (the subject prefix, rule 1 of this hook). A tool trailer adds a second, unqueryable axis, makes a provenance claim that ages badly, and taxes every git log a human reads, forever."
  msg4="Next: delete the line, or configure your harness not to add it, and commit again."
  msg5="  A Co-Authored-By naming a HUMAN is fine; the tool markers rejected are: $(printf '%s' "$TOOL_TRAILER_MARKERS" | tr '|' ' ')"
  msg6="  Importing a third party's commit verbatim?  MSG_OK=1 git commit …"
  if command -v kit_refuse >/dev/null 2>&1; then
    kit_refuse 1 commit-msg-generated-attribution "$msg1" "" "$msg2" "" "$msg3" "" "$msg4" "$msg5" "" "$msg6"
  fi
  printf '%s\n' "$msg1" "" "$msg2" "" "$msg3" "" "$msg4" "$msg5" "" "$msg6" >&2
  exit 1   # exit-class: fallback
fi

# --- RULE (1): the subject declares the acting role -------------------------------
# First non-comment, non-blank line = the subject.
subject="$(printf '%s\n' "$cleaned" | grep -vE '^[[:space:]]*$' | head -1 || true)"

# Empty subject → let git handle it (it aborts the commit on its own). Not our job.
[ -z "$subject" ] && exit 0

# Auto-exempt host/git-generated subjects (never authored under a role). "Merge commit '"
# REQUIRES the quote: that is the literal shape `git merge <sha>` writes
# (`Merge commit '<full-hash>'`), and without the quote the glob also matches an ordinary,
# human-authored subject that happens to start with the same two words
# ("Merge commit messages into one doc") — never generated by git, and wrongly exempted from
# the role-tag rule.
case "$subject" in
  "Merge branch "*|"Merge remote-tracking branch "*|"Merge pull request "*|"Merge tag "*|"Merge commit '"*) exit 0 ;;
  "Revert \""*|"Revert '"*) exit 0 ;;
  # Git's own squash template only: a wider "Squash"* glob exempts human subjects, and the
  # kit's own squash subject carries a role prefix.
  "Squashed commit of the following:"*) exit 0 ;;
  "fixup! "*|"squash! "*|"amend! "*) exit 0 ;;   # rebase autosquash markers
esac

# Accept when the subject starts with a known role tag: [Role] …
if printf '%s' "$subject" | grep -qE "^\[($ROLE_PREFIXES)\] "; then
  exit 0
fi

# The rejection message lists the accepted tags DERIVED from ROLE_PREFIXES above,
# so a set change cannot leave the help text lying about what is legal.
rmsg1="✗ Commit-message guard: subject must start with a role tag."
rmsg2="  Subject: $subject"
rmsg3="  Expected one of:  $(printf '%s' "$ROLE_PREFIXES" | tr '|' '\n' | sed 's/^/[/; s/$/]/' | tr '\n' ' ')"
rmsg4="  (the adapter's § 'Role-attribution commit prefixes' — the prefix is the audit trail)."
rmsg5="Next: commit again with a subject that starts with one of those tags. Examples:"
rmsg6="    [Dev] <PREFIX>-001: add the download --help usage example"
rmsg7="    [QA] <PREFIX>-001 → qa_complete: PASS. Squash-merged into the trunk."
rmsg8="  Genuine one-off that can't carry a tag?  MSG_OK=1 git commit …"
if command -v kit_refuse >/dev/null 2>&1; then
  kit_refuse 1 commit-msg-role-prefix "$rmsg1" "" "$rmsg2" "" "$rmsg3" "$rmsg4" "" "$rmsg5" "$rmsg6" "$rmsg7" "" "$rmsg8"
fi
printf '%s\n' "$rmsg1" "" "$rmsg2" "" "$rmsg3" "$rmsg4" "" "$rmsg5" "$rmsg6" "$rmsg7" "" "$rmsg8" >&2
exit 1   # exit-class: fallback
